exports[`Login.styles > InputEmail SHOULD match snapshot > atomic username credentials element layout render 1`] = `
.c2 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #5d615f;
  width: 24px;
  height: 24px;
  transition: transform 0.2s ease-in-out,color 0.2s;
  user-select: none;
  transform: rotate(0deg);
}

.c2 svg {
  width: 100%;
  height: 100%;
}

.c2 svg path,
.c2 svg circle,
.c2 svg rect {
  fill: currentColor!important;
}

.c1 {
  align-items: center;
  color: #999e9c;
  display: flex;
  flex-shrink: 0;
  justify-content: center;
}

.c0 {
  align-items: center;
  background-color: rgba(17, 19, 18, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  height: 48px;
  padding: 0 16px;
  transition: border-color 0.2s;
  width: 100%;
}

.c0:focus-within {
  border-color: #ff8b22;
}

.c3 {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  height: 100%;
  width: 100%;
  margin: 0 16px;
  color: #f0f2f1;
  font-family: Outfit-Regular;
  font-size: 14px;
  font-weight: 400;
  text-transform: none;
}

.c3::placeholder {
  color: #5d615f;
  font-family: Outfit-Regular;
  font-weight: 400;
  text-transform: none;
}

.c3:-webkit-autofill,
.c3:-webkit-autofill:hover,
.c3:-webkit-autofill:focus,
.c3:-webkit-autofill:active {
  -webkit-box-shadow: 0 0 0px 1000px transparent inset!important;
  -webkit-text-fill-color: #f0f2f1!important;
  box-shadow: 0 0 0px 1000px transparent inset!important;
  transition: background-color 9999s ease-in-out 0s;
}

<div>
  <div
    class="c0"
  >
    <div
      class="c1"
    >
      <div
        aria-hidden="true"
        class="c2"
      >
        <svg
          class="h-full w-full"
          height="1em"
          viewBox="0 0 24 24"
          width="1em"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5-4-8-4z"
          />
        </svg>
      </div>
