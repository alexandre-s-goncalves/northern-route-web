  text-transform: none;
  transition: opacity 0.2s,transform 0.1s;
  width: 100%;
}

.c0:hover {
  opacity: 0.95;
}

.c0:active {
  transform: scale(0.98);
}

.c0:disabled {
  background: #434645;
  box-shadow: none;
  color: #999e9c;
  cursor: not-allowed;
  transform: none;
}

